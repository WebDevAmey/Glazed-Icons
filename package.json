{
  "name": "glaze-icons",
  "version": "0.1.0",
  "description": "194 glossy, colour-coded app-tile icons as SVG, React and plain JS.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./svg/*": "./svg/*",
    "./icons.json": "./icons.json"
  },
  "files": [
    "dist",
    "svg",
    "icons.json",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "icons",
    "svg",
    "react",
    "glossy",
    "app-icons",
    "gradient",
    "tailwind"
  ],
  "scripts": {
    "icons:extract": "python3 scripts/extract.py",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@tabler/icons": "3.34.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WebDevAmey/Glazed-Icons.git"
  }
}
